# Copy to .env and adjust.
DATABASE_URL="postgresql://user@localhost:5432/vtpeerpulse"

# Generate with: openssl rand -base64 32 (min 32 chars enforced in production)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used in emails (invite/reset links, round notifications).
APP_BASE_URL="http://localhost:3000"

# AI provider (any OpenAI-compatible API). Empty AI_API_KEY = offline mock provider.
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="30000"

# Comma-separated university email domains accepted by the CSV importer.
ALLOWED_EMAIL_DOMAINS="vt.edu"

# Email delivery. "console" logs emails instead of sending (dev default).
# "resend" posts to any Resend-compatible HTTP API (requires EMAIL_API_KEY).
EMAIL_PROVIDER="console"
EMAIL_FROM="VT PeerPulse <no-reply@example.edu>"
EMAIL_API_KEY=""
EMAIL_API_URL="https://api.resend.com/emails"

# University SSO via any OIDC-compliant IdP (Azure AD, Okta, Shibboleth OIDC).
# Leave empty to disable the SSO button. Accounts must already exist (roster
# import) — SSO never auto-provisions users.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_PROVIDER_NAME="University SSO"

# In-process scheduler (auto open/close rounds, deadline reminders).
SCHEDULER_ENABLED="true"
