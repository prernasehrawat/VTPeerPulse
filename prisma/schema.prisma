generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PROFESSOR
}

enum CourseRole {
  STUDENT
  INSTRUCTOR
  TA
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
}

enum SummaryStatus {
  DRAFT
  RELEASED
}

enum RoundStatus {
  DRAFT
  OPEN
  CLOSED
}

enum QuestionType {
  RATING
  TEXT
}

enum SummaryKind {
  COMPLAINTS
  POSITIVES
  CONSTRUCTIVE
  INSTRUCTOR
  STUDENT_FEEDBACK
}

enum SummarySubject {
  ROUND
  TEAM
  STUDENT
}

enum AlertType {
  LOW_AVERAGE
  DOWNWARD_TREND
  REPEATED_CONCERN
  MISSING_SUBMISSION
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  name                String
  role                Role             @default(STUDENT)
  passwordHash        String?
  active              Boolean          @default(true)
  enrollments         CourseEnrollment[]
  memberships         TeamMembership[]
  authTokens          AuthToken[]
  submissions         Submission[]
  drafts              EvaluationDraft[]
  evaluationsReceived PeerEvaluation[] @relation("evaluatee")
  alerts              Alert[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([role])
}

/// A course offering in a specific term. All rosters, teams, questions,
/// and rounds are scoped to a course.
model Course {
  id          String             @id @default(cuid())
  code        String
  name        String
  term        String
  timezone    String             @default("America/New_York")
  active      Boolean            @default(true)
  enrollments CourseEnrollment[]
  teams       Team[]
  memberships TeamMembership[]
  questions   Question[]
  rounds      EvaluationRound[]
  alerts      Alert[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([code, term])
}

model CourseEnrollment {
  id        String     @id @default(cuid())
  courseId  String
  userId    String
  role      CourseRole @default(STUDENT)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model Team {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  memberships TeamMembership[]
  alerts      Alert[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([courseId, name])
}

model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([teamId])
}

model EvaluationRound {
  id          String              @id @default(cuid())
  courseId    String
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  sprint      Int
  status      RoundStatus         @default(DRAFT)
  opensAt     DateTime?
  closesAt    DateTime?
  submissions Submission[]
  summaries   AISummary[]
  alerts      Alert[]
  snapshots   AnalyticsSnapshot[]
  drafts      EvaluationDraft[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([courseId, sprint])
}

model Question {
  id        String       @id @default(cuid())
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType @default(RATING)
  required  Boolean      @default(true)
  active    Boolean      @default(true)
  order     Int
  answers   Answer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([courseId, active, order])
}

/// One per (round, evaluator). Locks all peer evaluations when submitted.
model Submission {
  id          String           @id @default(cuid())
  roundId     String
  evaluatorId String
  round       EvaluationRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  evaluator   User             @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluations PeerEvaluation[]
  submittedAt DateTime         @default(now())

  @@unique([roundId, evaluatorId])
  @@index([roundId])
}

model PeerEvaluation {
  id           String     @id @default(cuid())
  submissionId String
  evaluateeId  String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evaluatee    User       @relation("evaluatee", fields: [evaluateeId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@unique([submissionId, evaluateeId])
  @@index([evaluateeId])
}

model Answer {
  id               String         @id @default(cuid())
  peerEvaluationId String
  questionId       String
  rating           Int?
  comment          String?
  peerEvaluation   PeerEvaluation @relation(fields: [peerEvaluationId], references: [id], onDelete: Cascade)
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([peerEvaluationId, questionId])
  @@index([questionId])
}

/// Server-side autosave of an in-progress evaluation. One per (round, evaluator);
/// deleted when the final immutable Submission is created. Lets a student resume
/// on any device and lets instructors see who has started but not yet submitted.
model EvaluationDraft {
  id          String          @id @default(cuid())
  roundId     String
  evaluatorId String
  round       EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  evaluator   User            @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  data        Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([roundId, evaluatorId])
  @@index([roundId])
}

model AnalyticsSnapshot {
  id        String          @id @default(cuid())
  roundId   String
  round     EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime        @default(now())

  @@index([roundId])
}

model AISummary {
  id          String          @id @default(cuid())
  roundId     String
  round       EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  subjectType SummarySubject
  subjectId   String?
  kind        SummaryKind
  content     String
  model       String
  status      SummaryStatus   @default(DRAFT)
  /// Set when an instructor edits the AI-generated text before releasing it, so
  /// UIs can distinguish an untouched AI draft from an instructor-revised one.
  editedAt    DateTime?
  releasedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([roundId, subjectType, subjectId])
}

model Alert {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  roundId   String?
  round     EvaluationRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  type      AlertType
  severity  AlertSeverity    @default(WARNING)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  message   String
  /// Structured alert data (value, threshold, previous) so UIs can re-render
  /// or localize without parsing the message string.
  meta      Json?
  resolved  Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([courseId, resolved])
  @@index([roundId, resolved])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

/// Key-value app settings (e.g. alert thresholds).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One-time tokens for account invites and password resets. Only a hash is stored.
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

/// Minimal DB-backed job queue polled by the in-process scheduler.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json?
  runAt       DateTime
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([completedAt, runAt])
}
